# Project source and configuration are intentionally tracked.
# Large Unreal content remains local until Git LFS or another binary
# versioning solution is available.

# Unreal-generated directories (matched at any depth, including plugins)
Binaries/
DerivedDataCache/
Intermediate/
Saved/
StagedBuilds/

# IDE and generated project files
.vs/
.idea/
.vscode/
*.sln
*.suo
*.user
*.userprefs
*.xcodeproj
*.xcworkspace
*.code-workspace
*.VC.db
*.VC.opendb
*.opensdf
*.sdf

# Compiler and linker output
__pycache__/
*.py[cod]
*.a
*.app
*.dll
*.dylib
*.exe
*.exp
*.gch
*.ipa
*.lai
*.lib
*.lo
*.o
*.obj
*.pch
*.pdb
*.so

# Unreal packaged output
*.pak
*.sig
*.ucas
*.utoc

# Unreal project and plugin content is binary and intentionally not tracked yet
Content/
*.uasset
*.umap

# Raw source assets that normally belong in LFS
SourceArt/
*.blend
*.exr
*.fbx
*.flac
*.hdr
*.mov
*.mp3
*.mp4
*.ogg
*.psd
*.tga
*.tif
*.tiff
*.wav

# Logs, temporary files, and operating-system metadata
*.log
*.tmp
.DS_Store
Thumbs.db
