# Project source, configuration, and selected Unreal content are tracked.
# Generated content and raw source art remain ignored.

# Unreal-generated directories (matched at any depth, including plugins)
Binaries/
DerivedDataCache/
Intermediate/
Saved/
StagedBuilds/
# UBT writes Mac packaging resources and a version counter here during a Mac build.
/Build/Mac/

# IDE and generated project files
.vs/
.idea/
.vscode/
*.sln
*.suo
*.user
*.userprefs
*.xcodeproj
*.xcworkspace
*.code-workspace
*.VC.db
*.VC.opendb
*.opensdf
*.sdf

# Compiler and linker output
*.a
*.app
*.dll
*.dylib
*.exe
*.exp
*.gch
*.ipa
*.lai
*.lib
*.lo
*.o
*.obj
*.pch
*.pdb
*.so

# Unreal packaged output
*.pak
*.sig
*.ucas
*.utoc

# Historical project/plugin binaries remain local; Aurelion owns its tracked assets.
Content/
*.uasset
*.umap
!/Content/
/Content/*
!/Content/Aurelion/
!/Content/Aurelion/**/*.uasset
!/Content/Aurelion/**/*.umap
# /Game/Cues is the sole configured GameplayCueNotifyPaths root (Config/DefaultGame.ini). Its
# assets are project-authored overrides of the Narrative originals and are required for cue
# resolution at runtime, so they belong in version control like any other production asset.
!/Content/Cues/
!/Content/Cues/**/*.uasset

# /Game/Input is entirely project-owned: BP_SovPlayerController names IMC_Combat as its
# DefaultMappingContext and DA_CombatInputs as its AbilityInputMappings, so these assets decide
# which keys reach gameplay at all. Threat focus and target cycling live here too.
!/Content/Input/
!/Content/Input/**/*.uasset

# The localization manifest and archives are where translation work is stored and edited, so they
# are source rather than build output and losing them would lose real work. The compiled .locres is
# regenerated from them by the gather in seconds and is deliberately left ignored.
!/Content/Localization/
!/Content/Localization/**/*.manifest
!/Content/Localization/**/*.archive
# Compiled outputs of the gather. Un-ignoring the folder above would otherwise let them in.
/Content/Localization/**/*.locres
/Content/Localization/**/*.locmeta

# Project-owned Cinderline correction; retain the surrounding pack/template exclusions.
!/Content/Abilities/
/Content/Abilities/*
!/Content/Abilities/Tarrik/
/Content/Abilities/Tarrik/*
!/Content/Abilities/Tarrik/GE_CinderlineThermal.uasset
!/Content/Abilities/Tarrik/GA_CinderlinePrimary.uasset
!/Content/Abilities/Tarrik/GA_Tarrik_CinderStickyGrenade.uasset
!/Content/Abilities/Tarrik/GA_Tarrik_VelkorransHunger.uasset
!/Content/Abilities/Tarrik/GA_Tarrik_CinderSlam.uasset
!/Content/Abilities/Tarrik/GA_Tarrik_CinderJudgement.uasset
!/Content/Abilities/Tarrik/GA_Tarrik_CinderlineRequiem.uasset
!/Content/Abilities/Selene/
/Content/Abilities/Selene/*
!/Content/Abilities/Selene/GA_Selene_StillpointGrenade.uasset
!/Content/Abilities/Selene/GA_Selene_VeritysWake.uasset
!/Content/Abilities/Selene/GA_Selene_StaccatoZero.uasset
!/Content/Abilities/Selene/GA_Selene_AxiomNullPulse.uasset
!/Content/Abilities/Selene/GA_Selene_Dispatch.uasset
!/Content/Items/
/Content/Items/*
!/Content/Items/Weapons/
/Content/Items/Weapons/*
!/Content/Items/Weapons/WI_Cinderline.uasset
!/Content/Items/Weapons/WI_Verity.uasset
!/Content/Items/Weapons/WI_Velkorran.uasset

# Project-owned Verity presentation and retargeted Twin Blade animation.
!/Content/Characters/
/Content/Characters/*
!/Content/Characters/Animation/
/Content/Characters/Animation/*
!/Content/Characters/Animation/ABP_SovVerityOverlay.uasset
!/Content/Characters/Animation/VerityTwinBlades/
!/Content/Characters/Animation/VerityTwinBlades/**/*.uasset
!/Content/Characters/Animation/SeleneGASPALS/
!/Content/Characters/Animation/SeleneGASPALS/**/*.uasset
!/Content/Characters/Animation/ProtagonistCasts/
!/Content/Characters/Animation/ProtagonistCasts/**/*.uasset
!/Content/Weapons/
/Content/Weapons/*
!/Content/Weapons/Visuals/
/Content/Weapons/Visuals/*
!/Content/Weapons/Visuals/BP_SovVerityWeaponVisual.uasset

